    "4_create immutable per-asset acceptance records only for machine_plus_manual_pass",
    "5_do_not_expand_generation automatically",
    "6_compile only after exact_8_of_8 regional acceptance rollup"
  ],
  "invariants": {
    "one_region_only": true,
    "accepted_ids_never_eligible": true,
    "attempts_per_requested_id_cap": 1,
    "manual_visual_qa_required": true,
    "automatic_acceptance": false,
    "automatic_batch_expansion": false,
    "compile_never_authorized_by_generation_trigger": true,
    "catalog_wide_launch_authorized": false,
    "runtime_import_proof": false,
    "executor_credentials_not_exposed_before_zero_spend_preflight": true,
    "live_canary_must_be_refrozen_before_qa": true
  }
}
