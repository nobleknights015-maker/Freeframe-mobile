{
  "schema": "plushbound.world_asset_pipeline_v2_activation_protocol.v1",
  "status": "LOCKED_MANAGER_SEQUENCE",
  "purpose": "Prevent paid execution during partially updated repository state and ensure every live canary returns to a frozen state before QA or follow-on work.",
  "pre_activation_requirements": [
    "master_v2_preflight_green",
    "shadow_activation_proof_green_for_exact_region_and_ids",
