    "executor_preflight_green_while_disabled_and_paid_job_skipped",
    "no_other_paid_region_active"
  ],
  "activation_order": [
    "1_keep_run_trigger_disabled",
    "2_update_freeze_gate_to_allow_one_bounded_paid_execution",
